# App
APP_NAME=Financial AI API
ENV=local

# Database (AWS RDS PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financial_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# 외부 API
DART_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# LLM
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

# Security
SECRET_KEY=change-me-in-production

#시가 배치
MARKET_DATA_BATCH_HOUR=15
MARKET_DATA_BATCH_MINUTE=40
MARKET_DATA_REQUEST_INTERVAL_SECONDS=1.1
